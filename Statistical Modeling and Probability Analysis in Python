        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import gamma\n",
        "\n",
        "# --- 1. DATA INPUT ---\n",
        "xi_10 = np.array([10, 73, 129, 42, 3])\n",
        "k_total = 14  # Sum of two routers with shape k=7 each\n",
        "\n",
        "# --- 2. CALCULATIONS ---\n",
        "# Calculate the sample mean (t-bar)\n",
        "sample_mean = np.mean(xi_10)\n",
        "\n",
        "# Calculate MLE for theta: theta_hat = mean / k_total\n",
        "theta_hat = sample_mean / k_total\n",
        "\n",
        "# --- 3. VISUALIZATION ---\n",
        "# Define the range for the x-axis\n",
        "t_axis = np.linspace(0, 180, 1000)\n",
