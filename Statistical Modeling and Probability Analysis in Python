        "import numpy as np\n",
        "import scipy.stats as stats\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- 1. PARAMETERS ---\n",
        "sigma0 = 42.1\n",
        "xi14 = np.array([885, 855, 888, 910, 878, 853, 840, 854, 868, 861])\n",
        "n = len(xi14)\n",
        "df = n - 1\n",
        "alpha = 0.05\n",
        "\n",
        "# --- 2. CALCULATIONS ---\n",
        "sample_var = np.var(xi14, ddof=1)\n",
        "chi_stat = (df * sample_var) / (sigma0**2)\n",
        "p_value = stats.chi2.cdf(chi_stat, df)\n",
        "chi_critical = stats.chi2.ppf(alpha, df)\n",
        "\n",
        "# --- 3. VISUALIZATION ---\n",
        "x = np.linspace(0, 25, 1000)\n",
        "y = stats.chi2.pdf(x, df)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(x, y, 'b-', label=f'Chi-squared Distribution (df={df})')\n",
        "\n",
        "# Fill rejection region (Left tail for \"more constant\")\n",
        "x_rejection = np.linspace(0, chi_critical, 100)\n",
        "y_rejection = stats.chi2.pdf(x_rejection, df)\n",
        "plt.fill_between(x_rejection, y_rejection, color='red', alpha=0.3, label=f'Rejection Region (alpha={alpha})')\n",
