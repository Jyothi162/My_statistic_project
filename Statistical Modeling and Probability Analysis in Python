        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import geom\n",
        "\n",
        "# Parameters\n",
        "p = 0.67\n",
        "xi_1 = 3\n",
        "\n",
        "# 1. Calculations\n",
        "expectation = 1 / p\n",
        "median = geom.median(p)\n",
        "\n",
        "# Find k where P(X=k) < 0.005\n",
        "k_values = []\n",
        "probs = []\n",
        "k = 1\n",
        "while True:\n",
        "    prob = geom.pmf(k, p)\n",
        "    k_values.append(k)\n",
        "    probs.append(prob)\n",
        "    if prob < 0.005:\n",
        "        break\n",
        "    k += 1\n",
        "\n",
        "# 2. Visualization\n",
        "plt.figure(figsize=(10, 6))\n",
        "bars = plt.bar(k_values, probs, color='skyblue', edgecolor='navy', alpha=0.7)\n",
        "\n",
        "# Add value labels\n",
        "for bar in bars:\n",
        "    yval = bar.get_height()\n",
        "    plt.text(bar.get_x() + bar.get_width()/2, yval + 0.01, f'{yval:.4f}', ha='center', va='bottom')\n",
        "\n",
        "# Mark Mean and Median\n",
        "plt.axvline(expectation, color='red', linestyle='--', label=f'Expectation: {expectation:.4f}')\n",
        "plt.axvline(median, color='green', linestyle=':', label=f'Median: {median}')\n",
        "\n",
        "plt.title(f'Task 1: Geometric Distribution (p={p})', fontsize=14)\n",
        "plt.xlabel('Number of Years (Trials) until First Meteorite', fontsize=12)\n",
        "plt.ylabel('Probability P(X=k)', fontsize=12)\n",
        "plt.xticks(k_values)\n",
        "plt.legend()\n",
        "plt.grid(axis='y', alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"Expectation: {expectation:.4f}\")\n",
        "print(f\"Median: {median}\")"
      ]
