        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- 1. DATA INPUT (xi_16) ---\n",
        "x_data = np.array([-13, 2, 7, -4, -16, -5, 13, -1, -18, 5, 4, 3, -7, -20, -10, -9, 0, -3, 6, -6, 1, 8, -2, -8, 10, -11])\n",
        "y_data = np.array([2.15e14, 1.25e04, 1.00e11, 1.82e08, 2.63e15, 2.45e09, 1.83e14, 27.78, 1.10e16, 1.11e09,\n",
        "                   1.57e08, 1.94e07, 1.02e11, 5.03e16, 1.25e10, 3.45e09, -0.15, 4.32e06, 1.00e10, 1.25e10,\n",
        "                   23.45, 1.00e12, 1.25e05, 3.45e10, 1.25e13, 2.91e13])\n",
        "\n",
        "degree = 11 # 12 parameters\n",
        "X = np.column_stack([x_data**i for i in range(degree + 1)])\n",
        "\n",
        "# --- 2. CALCULATIONS ---\n",
        "theta_ols = np.linalg.solve(X.T @ X, X.T @ y_data)\n",
        "\n",
        "lam = 1.0\n",
        "I = np.eye(degree + 1)\n",
        "I[0, 0] = 0 # No penalty on intercept\n",
        "theta_ridge = np.linalg.solve(X.T @ X + lam * I, X.T @ y_data)\n",
        "\n",
        "# --- 3. VISUALIZATION ---\n",
        "x_plot = np.linspace(min(x_data), max(x_data), 1000)\n",
        "X_plot = np.column_stack([x_plot**i for i in range(degree + 1)])\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.scatter(x_data, y_data, color='red', label='Data Points', alpha=0.6)\n",
        "plt.plot(x_plot, X_plot @ theta_ols, 'b--', label='OLS Fit')\n",
        "plt.plot(x_plot, X_plot @ theta_ridge, 'g-', label=f'Ridge Fit (lambda={lam})')\n",
        "plt.yscale('symlog')\n",
        "plt.title('Task 5: OLS vs Ridge Regression (11th Degree Polynomial)')\n",
        "plt.xlabel('x')\n",
        "plt.ylabel('f(x) (Symlog Scale)')\n",
        "plt.legend()\n",
        "plt.grid(True, which=\"both\", alpha=0.3)\n",
