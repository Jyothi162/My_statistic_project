        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.integrate import quad\n",
        "from scipy.optimize import fsolve\n",
        "\n",
        "# --- 1. PARAMETERS (Updated) ---\n",
        "xi5, xi6, xi7, xi8 = 0.75, 9, 0.24, 2\n",
        "\n",
        "# Survival Function S(y)\n",
        "def S(y):\n",
        "    return xi5 * np.exp(-xi6 * y**2) + xi7 * np.exp(-xi8 * y**2)\n",
        "\n",
        "# PDF f(y) = -S'(y)\n",
        "def f(y):\n",
        "    return 2 * xi5 * xi6 * y * np.exp(-xi6 * y**2) + 2 * xi7 * xi8 * y * np.exp(-xi8 * y**2)\n",
        "\n",
        "# --- 2. CALCULATIONS ---\n",
        "# Probability P(2 < Y < 4)\n",
        "prob_2_4 = S(2) - S(4)\n",
        "\n",
        "# Mean and Variance via numerical integration\n",
        "mean_y, _ = quad(lambda y: y * f(y), 0, np.inf)\n",
        "mean_y2, _ = quad(lambda y: y**2 * f(y), 0, np.inf)\n",
        "variance_y = mean_y2 - (mean_y**2)\n",
        "\n",
        "# Quartiles (solving S(y) = 1 - p)\n",
        "q1 = fsolve(lambda y: S(y) - 0.75, 0.2)[0]\n",
        "q2 = fsolve(lambda y: S(y) - 0.50, 0.3)[0]\n",
        "q3 = fsolve(lambda y: S(y) - 0.25, 0.4)[0]\n",
        "\n",
        "# --- 3. VISUALIZATION ---\n",
        "y_range = np.linspace(0, 2.0, 500)\n",
        "# Rejection sampling for histogram\n",
        "sample = []\n",
        "while len(sample) < 10000:\n",
        "    y_cand, u = np.random.uniform(0, 2.5), np.random.uniform(0, 2.5)\n",
        "    if u < f(y_cand): sample.append(y_cand)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.hist(sample, bins=60, density=True, alpha=0.3, color='gray', label='Simulated Histogram')\n",
        "plt.plot(y_range, f(y_range), 'b-', lw=2, label='Theoretical PDF $f(y)$')\n",
        "plt.axvline(q1, color='green', linestyle='--', label=f'Q1: {q1:.3f}')\n",
        "plt.axvline(q2, color='red', linestyle='--', label=f'Median (Q2): {q2:.3f}')\n",
        "plt.axvline(q3, color='orange', linestyle='--', label=f'Q3: {q3:.3f}')\n",
        "\n",
        "plt.title('Task 2: Probability Density Function and Waiting Time Histogram', fontsize=14)\n",
        "plt.xlabel('Time $y$ (hours)')\n",
        "plt.ylabel('Density')\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"P(2 < Y < 4): {prob_2_4:.4e}\")\n",
        "print(f\"Mean: {mean_y:.4f}, Variance: {variance_y:.4f}\")\n",
        "print(f\"Quartiles: Q1={q1:.3f}, Q2={q2:.3f}, Q3={q3:.3f}\")"
