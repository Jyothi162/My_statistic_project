        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import gamma\n",
        "\n",
        "# --- 1. PARAMETERS ---\n",
        "alpha_prior = 74\n",
        "beta_prior = 41\n",
        "n = 10\n",
        "alpha_likelihood = 3\n",
        "sample_mean = 28.74\n",
        "sum_x = n * sample_mean\n",
        "\n",
        "# --- 2. POSTERIOR UPDATE ---\n",
        "alpha_post = alpha_prior + (n * alpha_likelihood)\n",
        "beta_post = beta_prior + sum_x\n",
        "\n",
        "# --- 3. POINT ESTIMATES ---\n",
        "post_mean = alpha_post / beta_post\n",
        "post_median = gamma.ppf(0.5, a=alpha_post, scale=1/beta_post)\n",
        "post_mode = (alpha_post - 1) / beta_post\n",
        "\n",
        "# --- 4. VISUALIZATION ---\n",
        "theta_range = np.linspace(0.1, 1.0, 1000)\n",
        "prior_pdf = gamma.pdf(theta_range, a=alpha_prior, scale=1/beta_prior)\n",
        "post_pdf = gamma.pdf(theta_range, a=alpha_post, scale=1/beta_post)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(theta_range, prior_pdf, label='Prior Gamma(74, 41)', color='gray', linestyle='--')\n",
        "plt.plot(theta_range, post_pdf, label='Posterior Gamma(104, 328.4)', color='darkorange', lw=2)\n",
        "plt.axvline(post_mean, color='red', linestyle=':', label=f'Post. Mean (Squared Error): {post_mean:.4f}')\n",
        "\n",
        "plt.title('Task 6: Bayesian Parameter Estimation', fontsize=14)\n",
        "plt.xlabel('Theta (θ)')\n",
        "plt.ylabel('Density')\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"Posterior Mean: {post_mean:.4f}\")\n",
        "print(f\"Posterior Median: {post_median:.4f}\")\n",
        "print(f\"Posterior Mode: {post_mode:.4f}\")"
      ],
